{
  "name": "netflo",
  "version": "0.1.0",
  "description": "Bond Wi-Fi, Ethernet, and USB tethering into a single virtual network interface",
  "main": "dist/main/index.js",
  "author": "NetFlo Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VHARD6/NetFlo.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "test": "npm run build:main && node --test test/**/*.test.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "repack": "node scripts/repack.js"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "ip": "^2.0.1",
    "koffi": "^2.9.0",
    "qrcode": "^1.5.4",
    "socks": "^2.8.3",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^2.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.netflo.app",
    "productName": "NetFlo",
    "copyright": "Copyright © 2026 NetFlo Contributors",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "resources/wintun/**"
    ],
    "extraResources": [
      {
        "from": "resources/wintun",
        "to": "wintun",
        "filter": [
          "**/*.dll"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "VHARD6",
      "repo": "NetFlo"
    }
  }
}
